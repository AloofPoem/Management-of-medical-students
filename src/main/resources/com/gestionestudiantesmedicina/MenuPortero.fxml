<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="bpMenu" prefHeight="850.0" prefWidth="1100.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestionestudiantesmedicina.controller.MenuPorteroController">
   
   <!-- PANEL LATERAL IZQUIERDO -->
   <left>
      <VBox prefWidth="280.0" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #3F2B63, #2A1A45);">
         <children>
            <!-- Encabezado del Menú -->
            <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 15 15 15 15; -fx-background-color: #2A1A45;">
               <children>
                  <ImageView fitHeight="100.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/san%20rafa%20(2).png" />
                     </image>
                  </ImageView>
                  
                  <!-- Nombre de la Institución -->
                  <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #2A1A45;">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="HOSPITAL" textFill="WHITE" />
                        <Label style="-fx-font-size: 10;" text="UNIVERSITARIO" textFill="#B4A5D1" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="San Rafael" textFill="WHITE" />
                        <Label style="-fx-font-size: 11; -fx-font-style: italic;" text="de Tunja" textFill="#B4A5D1" />
                     </children>
                  </VBox>
                  
                  <Separator prefWidth="200.0" style="-fx-background-color: #B4A5D1;" />
                  
                  <!-- Título del Menú -->
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-letter-spacing: 2;" text="MENÚ PORTERO" textFill="WHITE">
                     <tooltip>
                        <Tooltip text="Sistema de Gestión Integral" />
                     </tooltip>
                  </Label>
               </children>
            </VBox>
            
            <!-- SCROLLPANE PARA LOS BOTONES -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <!-- Botones de Navegación -->
                  <VBox spacing="5.0" style="-fx-padding: 10 12 15 12;">
                     <children>
                        
                                    <!-- Botón Gestionar Registros -->
                        <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#loadRecord" prefHeight="45.0" style="-fx-background-color: #5A4278; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                           <graphic>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 20; -fx-min-width: 28;" text="📝" />
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="GESTIONAR REGISTROS" textFill="WHITE" />
                                 </children>
                              </HBox>
                           </graphic>
                           <tooltip>
                              <Tooltip text="Administrar registros del sistema" />
                           </tooltip>
                        </Button>
                        
                              <!-- Separador antes de Cerrar Sesión -->
                        <Region prefHeight="8.0" />
                        
                              <!-- Botón Cerrar Sesión -->
                        <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#logout" prefHeight="45.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                           <graphic>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-font-size: 20; -fx-min-width: 28;" text="🚪" />
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="CERRAR SESIÓN" textFill="WHITE" />
                                 </children>
                              </HBox>
                           </graphic>
                           <tooltip>
                              <Tooltip text="Salir del sistema" />
                           </tooltip>
                        </Button>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            
            <!-- Footer del Panel Lateral -->
            <VBox alignment="CENTER" prefHeight="59.0" prefWidth="280.0" spacing="3.0" style="-fx-padding: 10; -fx-background-color: #1A0F2E;">
               <children>
                  <Label fx:id="lblFechaHora" style="-fx-text-fill: #B4A5D1; -fx-font-size: 9;" text="Fecha y Hora">
                     <tooltip>
                        <Tooltip text="Fecha y hora actual" />
                     </tooltip>
                  </Label>
                  <Label style="-fx-font-size: 8; -fx-font-style: italic;" text="v1.0.0" textFill="#888888" />
               </children>
            </VBox>
         </children>
         <effect>
            <DropShadow color="#00000033" radius="15" spread="0.1" />
         </effect>
      </VBox>
   </left>
   
   <!-- ÁREA CENTRAL CON SCROLLPANE -->
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true" style="-fx-background-color: white; -fx-background: white;" vbarPolicy="AS_NEEDED">
         <content>
            <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 20 15 20 15; -fx-background-color: white;">
               <children>
                  <!-- Ícono de Bienvenida -->
                  <StackPane>
                     <children>
                        <Label style="-fx-font-size: 40;" text="🏥">
                           <effect>
                              <DropShadow color="#3F2B6333" radius="12" spread="0.3" />
                           </effect>
                        </Label>
                     </children>
                  </StackPane>
                  
                  <!-- Título de Bienvenida -->
                  <VBox alignment="CENTER" spacing="6.0">
                     <children>
                        <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #3F2B63;" text="Bienvenidos al Menú Portero">
                           <effect>
                              <DropShadow color="#3F2B6322" radius="5" spread="0.2" />
                           </effect>
                        </Label>
                        
                        <Label style="-fx-font-size: 12; -fx-text-fill: #6C757D; -fx-font-weight: bold; -fx-letter-spacing: 2;" text="SISTEMA DE GESTIÓN PORTERO" />
                        
                        <Separator prefWidth="250.0" style="-fx-background-color: #3F2B63;" />
                        
                        <Label style="-fx-font-size: 10; -fx-text-fill: #888888; -fx-font-style: italic;" text="SELECCIONE UNA DE LAS OPCIONES DE LA IZQUIERDA PARA INICIAR" textAlignment="CENTER" wrapText="true" />
                     </children>
                  </VBox>
                  
                  <!-- Tarjetas Informativas -->
                  <HBox alignment="CENTER" spacing="15.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   
   <!-- BARRA SUPERIOR (Header) -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: linear-gradient(to right, #3F2B63, #5A4278); -fx-padding: 8 20;">
         <children>
            <Label style="-fx-font-size: 20;" text="🏥" />
            <VBox spacing="1">
               <children>
                  <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;" text="SISTEMA DE GESTIÓN PORTERO" />
                  <Label style="-fx-font-size: 10; -fx-text-fill: #D1C4E9;" text="Hospital Universitario San Rafael de Tunja" />
               </children>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Notificaciones y Usuario -->
            <HBox alignment="CENTER" spacing="12.0" />
         </children>
         <effect>
            <DropShadow color="#00000044" radius="8" spread="0.1" />
         </effect>
      </HBox>
   </top>
   
   <!-- BARRA INFERIOR (Footer) -->
   <bottom>
      <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2A1A45; -fx-padding: 6;">
         <children>
            <Label style="-fx-text-fill: #B4A5D1; -fx-font-size: 9;" text="© 2024 Hospital Universitario San Rafael de Tunja" />
            <Label style="-fx-text-fill: #666666;" text="•" />
            <Label style="-fx-text-fill: #B4A5D1; -fx-font-size: 9;" text="Sistema de Gestión v1.0.0" />
            <Label style="-fx-text-fill: #666666;" text="•" />
            <Label style="-fx-text-fill: #B4A5D1; -fx-font-size: 9;" text="Todos los derechos reservados" />
         </children>
      </HBox>
   </bottom>
   
</BorderPane>
