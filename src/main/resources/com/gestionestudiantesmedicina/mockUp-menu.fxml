<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   
   <!-- PANEL LATERAL IZQUIERDO -->
   <left>
      <VBox prefWidth="280.0" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #3F2B63, #2A1A45);">
         <children>
            <!-- Encabezado del Menú -->
            <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 30 20 30 20; -fx-background-color: #2A1A45;">
               <children>
                  <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../../../../../../Downloads/Gemini_Generated_Image_ezdlz1ezdlz1ezdl.png" />
                     </image>
                  </ImageView>
                  
                  <!-- Nombre de la Institución -->
                  <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #2A1A45;">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="HOSPITAL" textFill="WHITE" />
                        <Label style="-fx-font-size: 13;" text="UNIVERSITARIO" textFill="#B4A5D1" />
                        <Label style="-fx-font-weight: bold; -fx-font-size: 20;" text="San Rafael" textFill="WHITE" />
                        <Label style="-fx-font-size: 14; -fx-font-style: italic;" text="de Tunja" textFill="#B4A5D1" />
                     </children>
                  </VBox>
                  
                  <Separator prefWidth="200.0" style="-fx-background-color: #B4A5D1;" />
                  
                  <!-- Título del Menú -->
                  <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-letter-spacing: 2;" text="MENÚ PRINCIPAL" textFill="WHITE">
                     <tooltip>
                        <Tooltip text="Sistema de Gestión Integral" />
                     </tooltip>
                  </Label>
               </children>
            </VBox>
            
            <!-- Espacio entre header y botones -->
            <Region prefHeight="20.0" />
            
            <!-- Botones de Navegación -->
            <VBox spacing="8.0" style="-fx-padding: 0 15 20 15;">
               <children>
                  <!-- Botón Gestionar Docente -->
                  <Button fx:id="btnGestionarDocente" alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #5A4278; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 24; -fx-min-width: 35;" text="👨‍🏫" />
                              <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="GESTIONAR DOCENTE" textFill="WHITE" />
                           </children>
                        </HBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Administrar información de docentes y profesores" />
                     </tooltip>
                  </Button>
                  
                  <!-- Botón Gestionar Estudiante -->
                  <Button fx:id="btnGestionarEstudiante" alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #5A4278; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 24; -fx-min-width: 35;" text="👨‍🎓" />
                              <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="GESTIONAR ESTUDIANTE" textFill="WHITE" />
                           </children>
                        </HBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Administrar información de estudiantes" />
                     </tooltip>
                  </Button>
                  
                  <!-- Botón Gestionar Clase -->
                  <Button fx:id="btnGestionarClase" alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #5A4278; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 24; -fx-min-width: 35;" text="📚" />
                              <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="GESTIONAR CLASE" textFill="WHITE" />
                           </children>
                        </HBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Administrar clases y asignaturas" />
                     </tooltip>
                  </Button>
                  
                  <!-- Botón Gestionar Horario -->
                  <Button fx:id="btnGestionarHorario" alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #5A4278; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 24; -fx-min-width: 35;" text="🕐" />
                              <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="GESTIONAR HORARIO" textFill="WHITE" />
                           </children>
                        </HBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Administrar horarios y programación académica" />
                     </tooltip>
                  </Button>
                  
                  <!-- Botón Gestionar Universidad -->
                  <Button fx:id="btnGestionarUniversidad" alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #5A4278; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 24; -fx-min-width: 35;" text="🏛️" />
                              <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="GESTIONAR UNIVERSIDAD" textFill="WHITE" />
                           </children>
                        </HBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Administrar información institucional" />
                     </tooltip>
                  </Button>
                  
                  <!-- Separador -->
                  <Region prefHeight="15.0" />
                  <Separator style="-fx-background-color: #B4A5D1;" />
                  <Region prefHeight="15.0" />
                  
                  <!-- Botón Ingreso/Salida -->
                  <Button fx:id="btnIngresoSalida" alignment="CENTER_LEFT" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #DC3545; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14; -fx-font-weight: bold;">
                     <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label style="-fx-font-size: 24; -fx-min-width: 35;" text="🚪" />
                              <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="INGRESO / SALIDA" textFill="WHITE" />
                           </children>
                        </HBox>
                     </graphic>
                     <tooltip>
                        <Tooltip text="Cerrar sesión y salir del sistema" />
                     </tooltip>
                  </Button>
               </children>
            </VBox>
            
            <!-- Footer del panel lateral -->
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 15; -fx-background-color: #2A1A45;">
               <children>
                  <Separator prefWidth="200.0" style="-fx-background-color: #B4A5D1;" />
                  <Label fx:id="lblFechaHora" style="-fx-font-size: 11;" text="📅 " textFill="#B4A5D1">
                     <tooltip>
                        <Tooltip text="Fecha y hora actual" />
                     </tooltip>
                  </Label>
                  <Label style="-fx-font-size: 10; -fx-font-style: italic;" text="v1.0.0" textFill="#888888" />
               </children>
            </VBox>
         </children>
         <effect>
            <DropShadow color="#00000033" radius="15" spread="0.1" />
         </effect>
      </VBox>
   </left>
   
   <!-- ÁREA CENTRAL -->
   <center>
      <StackPane style="-fx-background-color: white;">
         <children>
            <!-- Contenido de Bienvenida -->
            <VBox alignment="CENTER" spacing="30.0" style="-fx-padding: 50;">
               <children>
                  <!-- Ícono de Bienvenida -->
                  <StackPane>
                     <children>
                        <Label style="-fx-font-size: 120;" text="🏥">
                           <effect>
                              <DropShadow color="#3F2B6333" radius="20" spread="0.3" />
                           </effect>
                        </Label>
                     </children>
                  </StackPane>
                  
                  <!-- Título de Bienvenida -->
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Label style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #3F2B63;" text="Bienvenidos al Menú Principal">
                           <effect>
                              <DropShadow color="#3F2B6322" radius="5" spread="0.2" />
                           </effect>
                        </Label>
                        
                        <Label style="-fx-font-size: 18; -fx-text-fill: #6C757D; -fx-font-weight: bold; -fx-letter-spacing: 3;" text="SISTEMA DE GESTIÓN INTEGRAL" />
                        
                        <Separator prefWidth="400.0" style="-fx-background-color: #3F2B63;" />
                        
                        <Label style="-fx-font-size: 16; -fx-text-fill: #888888; -fx-font-style: italic;" text="SELECCIONE UNA DE LAS OPCIONES DE LA IZQUIERDA PARA INICIAR" textAlignment="CENTER" wrapText="true" />
                     </children>
                  </VBox>
                  
                  <!-- Tarjetas Informativas -->
                  <HBox alignment="CENTER" spacing="30.0">
                     <children>
                        <!-- Tarjeta 1: Docentes -->
                        <VBox alignment="CENTER" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #F8F9FA; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-border-radius: 15;">
                           <children>
                              <Label style="-fx-font-size: 48;" text="👨‍🏫" />
                              <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #3F2B63;" text="Docentes" />
                              <Label style="-fx-font-size: 11; -fx-text-fill: #6C757D; -fx-text-alignment: center;" text="Gestión completa de profesores y personal académico" wrapText="true" />
                           </children>
                           <effect>
                              <DropShadow color="#00000011" radius="10" spread="0.1" />
                           </effect>
                        </VBox>
                        
                        <!-- Tarjeta 2: Estudiantes -->
                        <VBox alignment="CENTER" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #F8F9FA; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-border-radius: 15;">
                           <children>
                              <Label style="-fx-font-size: 48;" text="👨‍🎓" />
                              <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #3F2B63;" text="Estudiantes" />
                              <Label style="-fx-font-size: 11; -fx-text-fill: #6C757D; -fx-text-alignment: center;" text="Administración integral de información estudiantil" wrapText="true" />
                           </children>
                           <effect>
                              <DropShadow color="#00000011" radius="10" spread="0.1" />
                           </effect>
                        </VBox>
                        
                        <!-- Tarjeta 3: Académico -->
                        <VBox alignment="CENTER" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #F8F9FA; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-border-radius: 15;">
                           <children>
                              <Label style="-fx-font-size: 48;" text="📚" />
                              <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #3F2B63;" text="Académico" />
                              <Label style="-fx-font-size: 11; -fx-text-fill: #6C757D; -fx-text-alignment: center;" text="Control de clases, horarios y programación" wrapText="true" />
                           </children>
                           <effect>
                              <DropShadow color="#00000011" radius="10" spread="0.1" />
                           </effect>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
   
   <!-- BARRA SUPERIOR (Header) -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #3F2B63, #5A4278); -fx-padding: 15 30;">
         <children>
            <Label style="-fx-font-size: 28;" text="🏥" />
            <VBox spacing="2">
               <children>
                  <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" text="SISTEMA DE GESTIÓN INTEGRAL" />
                  <Label style="-fx-font-size: 12; -fx-text-fill: #D1C4E9;" text="Hospital Universitario San Rafael de Tunja" />
               </children>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Notificaciones y Usuario -->
            <HBox alignment="CENTER" spacing="15.0" />
         </children>
         <effect>
            <DropShadow color="#00000044" radius="10" spread="0.1" />
         </effect>
      </HBox>
   </top>
   
   <!-- BARRA INFERIOR (Footer) -->
   <bottom>
      <HBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #2A1A45; -fx-padding: 12;">
         <children>
            <Label style="-fx-text-fill: #B4A5D1; -fx-font-size: 11;" text="© 2024 Hospital Universitario San Rafael de Tunja" />
            <Label style="-fx-text-fill: #666666;" text="•" />
            <Label style="-fx-text-fill: #B4A5D1; -fx-font-size: 11;" text="Sistema de Gestión v1.0.0" />
            <Label style="-fx-text-fill: #666666;" text="•" />
            <Label style="-fx-text-fill: #B4A5D1; -fx-font-size: 11;" text="Todos los derechos reservados" />
         </children>
      </HBox>
   </bottom>
   
</BorderPane>
