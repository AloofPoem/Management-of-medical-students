<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gestionestudiantesmedicina.controller.PruebaController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Subida de Documentos PDF" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#handleSeleccionarArchivo" text="Seleccionar PDF" />
        <Label fx:id="lblNombreArchivo" text="Ningún archivo seleccionado" textFill="#666666" />
    </HBox>

    <Button fx:id="btnSubir" disable="true" onAction="#handleSubirArchivo" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Guardar en Base de Datos" />

    <Button fx:id="btnVerPdf" onAction="#handleVerArchivo" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Abrir PDF Guardado" />
   <TextField fx:id="idF" />

    
    
    <ProgressBar fx:id="progressBar" prefWidth="200.0" visible="false" />

</VBox>
